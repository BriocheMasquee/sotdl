{
  "debug": false,
  "spacing": 0,
  "padding": [
    20
  ],
  "views": [
    {
      "style": "entityTitle",
      "value": "**{{name|uppercase}}**",
      "link": "https://www.google.com/search?tbm=isch&q=Shadow+of+the+Demon+Lord+{{name}}"
    },
    {
      "type": "divider",
      "bgColor": "#000000",
      "height": 2.5,
      "padding": [
        0
      ]
    },
    {
      "type": "spacer"
    },
    {
      "type": "text",
      "value": "{{descr}}",
      "visibleIf": "{% if descr %}true{% endif %}"
    },
    {
      "type": "vStack",
      "padding": [
        8
      ],
      "views": [
        {
          "type": "list",
          "attribute": "data.trait",
          "views": [
            {
              "type": "text",
              "style": "body",
              "value": "{% if name %}**{{name}}.**{% endif %} {{text}}"
            }
          ]
        }
      ]
    },
    {
      "type": "vStack",
      "padding": [
        0,
        5
      ],
      "views": [
        {
          "type": "text",
          "style": "body-info",
          "value": "{{data.tables}}",
          "visibleIf": "{% if data.tables %}true{% endif %}"
        }
      ]
    },
    {
      "type": "divider",
      "bgColor": "#000000",
      "height": 1.5,
      "padding": [
        0
      ]
    },
    {
      "type": "text",
      "style": "source",
      "padding": [
        5,
        0,
        0,
        0
      ],
      "value": "*{{'Common.Source'|l}} : {{ sourceFormatted }}*",
      "visibleIf": "{{sourceFormatted}}"
    }
  ]
}
