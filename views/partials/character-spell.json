{
  "type": "hStack",
  "alignment": "bottom",
  "views": [
    {
      "type": "vStack",
      "link": "{{reference}}",
      "views": [
        {
          "value": "**{{name}}**",
          "style": "characterTraitTitle"
        }
      ]
    },
    {
      "type": "image",
      "value": "/icons/tradition/darkmagic.png",
      "height": 20,
      "custom": {
        "renderingMode": "original"
      },
      "visibleIf": "{{spellTradition.darkMagic == true}}"
    },
    {
      "type": "image",
      "value": "/icons/tradition/psychic.png",
      "height": 20,
      "custom": {
        "renderingMode": "original"
      },
      "visibleIf": "{{spellTradition.psychicTradition == true}}"
    },
    {
      "type": "image",
      "value": "/icons/tradition/incantation.png",
      "height": 20,
      "custom": {
        "renderingMode": "original"
      },
      "visibleIf": "{{spellTradition.onlyIncantation == true}}"
    },
    {
      "type": "spacer",
      "width": -1
    },
    {
      "style": "characterSpellSubtitle",
      "alignment": "trailing",
      "value": "{{definition.data.spellTradition.tradition|map: 'SpellTradition'|l}} • {{definition.data.spellType|map: 'SpellType'|l}} {{definition.data.spellRank}}"
    },
    {
      "type": "checkboxGroup",
      "attribute": "usesSpent",
      "action": {
        "attribute": "{{keyPath}}.usesSpent"
      },
      "custom": {
        "range": {
          "max": "usesMaximum"
        },
        "checkboxStyle": {
          "default": {
            "tintColor": "#9B0619"
          },
          "checked": {
            "tintColor": "#9B0619"
          }
        }
      }
    }
  ]
}
