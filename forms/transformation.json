        },
        {
          "title": "Transformation.CorruptionRelative",
          "type": "form",
          "attribute": "data.corruption",
          "form": {
            "title": "Characteristics.Corruption",
            "partial": "ancestry-corruption"
          },
          "text": "{% if data.corruption.mode == 'variable' %}{% if data.corruption.dice != nil %}{{data.corruption.dice}}{% else %}—{% endif %}{% else %}{% if data.corruption.value != nil %}{{data.corruption.value|signed}}{% else %}—{% endif %}{% endif %}"
        },
        {
          "title": "Transformation.InsanityRemoved",
          "type": "toggle",
          "attribute": "data.insanityRemoved"
        }
