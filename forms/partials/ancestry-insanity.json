          "attributeType": "ValueMode"
        },
        {
          "title": "Characteristics.StartFixed",
          "type": "number",
          "attribute": "value",
          "visibleIf": "{% if mode != 'variable' %}true{% endif %}"
        },
        {
          "title": "Characteristics.StartDice",
          "type": "text",
          "placeholder": "Ancestry.ExampleFormulaShort",
          "attribute": "dice",
          "visibleIf": "{% if mode == 'variable' %}true{% endif %}"
        }
      ]
    }
  ]
}
