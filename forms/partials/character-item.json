{
  "sections": [
    {
      "type": "group",
      "fields": [
        {
          "title": "Character.Quantity",
          "type": "number",
          "attribute": "quantity"
        }
      ]
    },
    {
      "type": "group",
      "fields": [
        {
          "placeholder": "Common.Name",
          "attribute": "name"
        }
      ]
    },
    {
      "title": "Common.Description",
      "type": "group",
      "fields": [
        {
          "title": "Common.Description",
          "type": "textArea",
          "attribute": "descr"
        }
      ]
    },
    {
      "type": "group",
      "fields": [
        {
          "title": "Item.Type",
          "type": "picker",
          "attribute": "itemType",
          "attributeType": "ItemType"
        },
        {
          "title": "Item.GearType",
          "type": "picker",
          "attribute": "gearType",
          "attributeType": "GearType",
          "visibleIf": "{{itemType == 'AdventuringGear'}}"
        },
        {
          "title": "Item.MarvelType",
          "type": "picker",
          "attribute": "marvelType",
          "attributeType": "MarvelType",
          "visibleIf": "{{itemType == 'Special'}}"
        }
      ]
    },
    {
      "type": "group",
      "visibleIf": "{{itemType == 'Armor' or itemType == 'Weapon' or itemType == 'Potion' or itemType == 'AdventuringGear' or itemType == 'Special'}}",
      "fields": [
        {
          "title": "Item.Price",
          "type": "text",
          "attribute": "price"
        },
        {
          "title": "Item.Availability",
          "type": "picker",
          "attribute": "availability",
          "attributeType": "Availability"
        }
      ]
    },
    {
      "type": "group",
      "visibleIf": "{{itemType == 'Potion' or itemType == 'AdventuringGear' or itemType == 'Special' or itemType == 'Relic' or weaponType == 'Ammunition'}}",
      "fields": [
        {
          "title": "Item.Uses",
          "type": "number",
          "attribute": "uses"
        }
      ]
    },
    {
      "type": "group",
      "visibleIf": "{{itemType == 'Armor'}}",
      "fields": [
        {
          "title": "Item.ArmorType",
          "type": "picker",
          "attribute": "armorType",
          "attributeType": "ArmorType"
        },
        {
          "title": "Item.Requirement",
          "type": "text",
          "attribute": "armorRequirement"
        },
        {
          "title": "Item.ArmorDefenseFixed",
          "type": "number",
          "attribute": "armorDefenseFixed"
        },
        {
          "title": "Item.ArmorDefenseAgility",
          "type": "number",
          "attribute": "armorDefenseAgility"
        }
      ]
    },
    {
      "type": "group",
      "visibleIf": "{{itemType == 'Weapon'}}",
      "fields": [
        {
          "title": "Item.WeaponType",
          "type": "picker",
          "attribute": "weaponType",
          "attributeType": "WeaponType"
        },
        {
          "title": "Weapon.AmmunitionType",
          "type": "picker",
          "attribute": "ammunitionType",
          "attributeType": "Ammunition",
          "visibleIf": "{{weaponType == 'Ammunition'}}"
        },
        {
          "title": "Characteristics.Damage",
          "type": "text",
          "attribute": "weaponDamage"
        },
        {
          "title": "Weapon.Hands",
          "type": "picker",
          "attribute": "weaponHands",
          "attributeType": "WeaponHands"
        },
        {
          "title": "Weapon.Property",
          "type": "form",
          "text": "{% include 'weapon-property.md' %}",
          "form": {
            "title": "Weapon.Property",
            "sections": [
              {
                "type": "group",
                "fields": [
                  {
                    "title": "Weapon.Reach",
                    "type": "toggle",
                    "attribute": "weaponReach"
                  },
                  {
                    "title": "Weapon.ReachValue",
                    "type": "number",
                    "attribute": "reachValue",
                    "visibleIf": "{{weaponReach}}"
                  },
                  {
                    "title": "Weapon.Defensive",
                    "type": "toggle",
                    "attribute": "weaponDefensive"
                  },
                  {
                    "title": "Weapon.DefensiveValue",
                    "type": "number",
                    "attribute": "defensiveValue",
                    "visibleIf": "{{weaponDefensive}}"
                  },
                  {
                    "title": "Weapon.AmmunitionRequirement",
                    "type": "toggle",
                    "attribute": "ammunitionRequirement"
                  },
                  {
                    "title": "Weapon.AmmunitionType",
                    "type": "picker",
                    "attribute": "ammunitionType",
                    "attributeType": "Ammunition",
                    "visibleIf": "{{ammunitionRequirement}}"
                  }
                ]
              },
              {
                "type": "multiPicker",
                "attribute": "weaponProperty",
                "attributeType": "WeaponProperty"
              }
            ]
          }
        },
        {
          "title": "Item.Requirement",
          "type": "text",
          "attribute": "weaponRequirement"
        }
      ]
    },
    {
      "title": "Item.RelicEffects",
      "type": "list",
      "attribute": "relic",
      "visibleIf": "{{itemType == 'Relic'}}",
      "form": {
        "title": "Item.RelicEffect",
        "partial": "generic-feature"
      }
    },
    {
      "title": "Entity.Item",
      "type": "group",
      "fields": [
        {
          "title": "Entity.Item",
          "type": "reference",
          "attribute": "reference",
          "attributeType": "Item"
        }
      ]
    }
  ]
}
