{
  "sections": [
    {
      "type": "group",
      "fields": [
        {
          "placeholder": "Common.Name",
          "attribute": "name"
        }
      ]
    },
    {
      "title": "Common.Description",
      "type": "group",
      "fields": [
        {
          "title": "Common.Description",
          "type": "textArea",
          "attribute": "descr"
        }
      ]
    },
    {
      "title": "Common.Attributes",
      "type": "group",
      "fields": [
        {
          "title": "Ancestry.StartingValuesMode",
          "type": "picker",
          "attribute": "startMode",
          "attributeType": "StartingValues",
          "placeholder": "StartingValues.Fixed"
        },
        {
          "type": "hStack",
          "fields": [
            {
              "title": "Attributes.STR",
              "type": "number",
              "attribute": "STR",
              "placeholder": "—",
              "alignment": "top"
            },
            {
              "title": "Attributes.AGI",
              "type": "number",
              "attribute": "AGI",
              "placeholder": "—",
              "alignment": "top"
            },
            {
              "title": "Attributes.INT",
              "type": "number",
              "attribute": "INT",
              "placeholder": "—",
              "alignment": "top"
            },
            {
              "title": "Attributes.WIL",
              "type": "number",
              "attribute": "WIL",
              "placeholder": "—",
              "alignment": "top"
            }
          ],
          "visibleIf": "{% if startMode == 'random' %}{% else %}true{% endif %}"
        },
        {
          "title": "Attributes.STR",
          "type": "text",
          "attribute": "STRRoll",
          "placeholder": "Ancestry.ExampleFormula",
          "visibleIf": "{% if startMode == 'variant' or startMode == 'random' %}true{% endif %}"
        },
        {
          "title": "Attributes.AGI",
          "type": "text",
          "attribute": "AGIRoll",
          "placeholder": "Ancestry.ExampleFormula",
          "visibleIf": "{% if startMode == 'variant' or startMode == 'random' %}true{% endif %}"
        },
        {
          "title": "Attributes.INT",
          "type": "text",
          "attribute": "INTRoll",
          "placeholder": "Ancestry.ExampleFormula",
          "visibleIf": "{% if startMode == 'variant' or startMode == 'random' %}true{% endif %}"
        },
        {
          "title": "Attributes.WIL",
          "type": "text",
          "attribute": "WILRoll",
          "placeholder": "Ancestry.ExampleFormula",
          "visibleIf": "{% if startMode == 'variant' or startMode == 'random' %}true{% endif %}"
        },
        {
          "title": "Attributes.Mod",
          "type": "textArea",
          "attribute": "attributeChoice"
        }
      ]
    },
    {
      "title": "Common.Characteristics",
      "type": "group",
      "fields": [
        {
          "title": "Characteristics.PerceptionBonus",
          "type": "number",
          "attribute": "perception",
          "placeholder": "0"
        },
        {
          "title": "Characteristics.DefenseFixed",
          "type": "number",
          "placeholder": "Characteristics.FromAgility",
          "attribute": "defense"
        },
        {
          "title": "Characteristics.Health",
          "type": "form",
          "attribute": "health",
          "form": {
            "title": "Characteristics.Health",
            "partial": "ancestry-health"
          },
          "text": "{{health.attribute|default: 'STR'|map: 'HealthAttribute'|l}}{% if health.bonus %} {{health.bonus|signed}}{% endif %}"
        },
        {
          "title": "Characteristics.Size",
          "type": "picker",
          "placeholder": "—",
          "attribute": "size",
          "attributeType": "BodySize"
        },
        {
          "title": "Characteristics.Speed",
          "type": "number",
          "attribute": "speed"
        },
        {
          "title": "Characteristics.Insanity",
          "type": "form",
          "attribute": "insanity",
          "form": {
            "title": "Characteristics.Insanity",
            "partial": "ancestry-insanity"
          },
          "text": "{% if insanity.mode == 'variable' %}{% if insanity.dice != nil %}{{insanity.dice}}{% else %}—{% endif %}{% else %}{% if insanity.value != nil %}{{insanity.value}}{% else %}0{% endif %}{% endif %}"
        },
        {
          "title": "Characteristics.Corruption",
          "type": "form",
          "attribute": "corruption",
          "form": {
            "title": "Characteristics.Corruption",
            "partial": "ancestry-corruption"
          },
          "text": "{% if corruption.mode == 'variable' %}{% if corruption.dice != nil %}{{corruption.dice}}{% else %}—{% endif %}{% else %}{% if corruption.value != nil %}{{corruption.value}}{% else %}0{% endif %}{% endif %}"
        }
      ]
    },
    {
      "title": "Common.Language&Profession",
      "type": "group",
      "fields": [
        {
          "title": "Common.Description",
          "type": "textArea",
          "attribute": "languagesProfessions"
        }
      ]
    },
    {
      "title": "Ancestry.TalentImmunitiesVulnerabilities",
      "type": "list",
      "attribute": "talent",
      "form": {
        "title": "Common.Talent",
        "partial": "talent-uses"
      }
    },
    {
      "title": "Level.Advantages",
      "type": "group",
      "fields": [
        {
          "title": "Ancestry.PowerfulAncestry",
          "type": "toggle",
          "attribute": "powerfulAncestry"
        },
        {
          "title": "Level1.Title",
          "attribute": "ancestryLevel1",
          "type": "form",
          "form": {
            "title": "Level1.Title",
            "partial": "character-ancestry-level"
          },
          "visibleIf": "{% if powerfulAncestry %}true{% endif %}"
        },
        {
          "title": "Level2.Title",
          "attribute": "ancestryLevel2",
          "type": "form",
          "form": {
            "title": "Level2.Title",
            "partial": "character-ancestry-level"
          },
          "visibleIf": "{% if powerfulAncestry %}true{% endif %}"
        },
        {
          "title": "Level4.Expert",
          "attribute": "ancestryLevel4",
          "type": "form",
          "form": {
            "title": "Level4.Expert",
            "partial": "character-ancestry-level"
          }
        },
        {
          "title": "Level5.Title",
          "attribute": "ancestryLevel5",
          "type": "form",
          "form": {
            "title": "Level5.Title",
            "partial": "character-ancestry-level"
          },
          "visibleIf": "{% if powerfulAncestry %}true{% endif %}"
        },
        {
          "title": "Level8.Title",
          "attribute": "ancestryLevel8",
          "type": "form",
          "form": {
            "title": "Level8.Title",
            "partial": "character-ancestry-level"
          },
          "visibleIf": "{% if powerfulAncestry %}true{% endif %}"
        }
      ]
    },
    {
      "type": "group",
      "fields": [
        {
          "title": "Common.Modifiers",
          "type": "modifiers",
          "attribute": "modifiers"
        }
      ]
    },
    {
      "title": "Entity.Ancestry",
      "type": "group",
      "fields": [
        {
          "title": "Entity.Ancestry",
          "type": "reference",
          "attribute": "reference",
          "attributeType": "Ancestry"
        }
      ]
    }
  ]
}
