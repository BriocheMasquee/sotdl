{
  "sections": [
    {
      "type": "group",
      "fields": [
        {
          "title": "Common.Characteristics",
          "type": "form",
          "attribute": "gains",
          "text": "{% if gains.perception != nil %}{{'Characteristics.Perception'|l}} {{gains.perception|signed}}{% endif %}{% if gains.defense != nil %}{% if gains.perception != nil %}, {% endif %}{{'Characteristics.Defense'|l}} {{gains.defense|signed}}{% endif %}{% if gains.health != nil %}{% if gains.perception != nil or gains.defense != nil %}, {% endif %}{{'Characteristics.Health'|l}} {{gains.health|signed}}{% endif %}{% if gains.speed != nil %}{% if gains.perception != nil or gains.defense != nil or gains.health != nil %}, {% endif %}{{'Characteristics.Speed'|l}} {{gains.speed|signed}}{% endif %}{% if gains.power != nil %}{% if gains.perception != nil or gains.defense != nil or gains.health != nil or gains.speed != nil %}, {% endif %}{{'Characteristics.Power'|l}} {{gains.power|signed}}{% endif %}{% if gains.custom %}{% if gains.perception != nil or gains.defense != nil or gains.health != nil or gains.speed != nil or gains.power != nil %}, {% endif %}{{gains.custom}}{% endif %}",
          "form": {
            "title": "Common.Characteristics",
            "partial": "level-gains"
          }
        }
      ]
    },
    {
      "type": "group",
      "fields": [
        {
          "title": "Level.Options",
          "type": "textArea",
          "attribute": "options"
        }
      ]
    },
    {
      "title": "Level.Auto.Attr",
      "type": "group",
      "fields": [
        {
          "title": "Level.AttrChoice",
          "type": "number",
          "attribute": "levelAttrChoice"
        }
      ]
    },
    {
      "title": "Level.Auto.LangProf",
      "type": "group",
      "fields": [
        {
          "title": "Level.Lang",
          "type": "toggle",
          "attribute": "levelLang"
        },
        {
          "title": "Level.Prof",
          "type": "toggle",
          "attribute": "levelProf"
        },
        {
          "title": "Level.LangProfOne",
          "type": "toggle",
          "attribute": "levelLangProfOne",
          "visibleIf": "{% if levelLang and levelProf %}true{% endif %}"
        },
        {
          "title": "Level.LangRights",
          "type": "toggle",
          "attribute": "levelLangRights"
        }
      ]
    },
    {
      "title": "Level.Auto.Magic",
      "type": "group",
      "fields": [
        {
          "title": "Level.Tradition",
          "type": "toggle",
          "attribute": "levelTradition"
        },
        {
          "title": "Level.Spell",
          "type": "toggle",
          "attribute": "levelSpell"
        },
        {
          "title": "Level.MagicOne",
          "type": "toggle",
          "attribute": "levelMagicOne",
          "visibleIf": "{% if levelTradition and levelSpell %}true{% endif %}"
        },
        {
          "title": "Level.TraditionOnly",
          "type": "multiPicker",
          "attribute": "levelTraditionOnly",
          "attributeType": "SpellTradition",
          "visibleIf": "{% if levelTradition or levelSpell %}true{% endif %}"
        },
        {
          "title": "Level.MagicChoices",
          "type": "number",
          "attribute": "levelMagicChoices"
        },
        {
          "title": "Level.Cantrip",
          "type": "toggle",
          "attribute": "levelCantrip"
        }
      ]
    },
    {
      "title": "Level.Auto.Talent",
      "type": "group",
      "fields": [
        {
          "title": "Level.Talent",
          "type": "toggle",
          "attribute": "levelTalent"
        },
        {
          "title": "Level.ChoicePick",
          "type": "number",
          "attribute": "levelChoicePick",
          "visibleIf": "{% if levelTalent %}true{% endif %}"
        },
        {
          "title": "Level.SpellInstead",
          "type": "toggle",
          "attribute": "levelSpellInstead",
          "visibleIf": "{% if levelTalent %}{% if levelSpell or levelTradition %}true{% endif %}{% endif %}"
        }
      ]
    },
    {
      "title": "Level.SpellsAuto",
      "type": "list",
      "attribute": "levelSpellsAuto",
      "custom": {
        "itemTitle": "{% if name %}{{name}}{% else %}{% set seg reference|split:'/' %}{% if seg.first == '' %}{% if seg.2 %}{{seg.2|split:'-'|join:' '|capitalizeFirstLetter}}{% else %}{{seg.last|split:'-'|join:' '|capitalizeFirstLetter}}{% endif %}{% else %}{% if seg.1 %}{{seg.1|split:'-'|join:' '|capitalizeFirstLetter}}{% else %}{{seg.last|split:'-'|join:' '|capitalizeFirstLetter}}{% endif %}{% endif %}{% endif %}",
        "map": {
          "name": "name"
        }
      },
      "form": {
        "title": "Entity.Spell",
        "sections": [
          {
            "type": "group",
            "fields": [
              {
                "title": "Entity.Spell",
                "type": "reference",
                "attribute": "reference",
                "attributeType": "Spell",
                "custom": {
                  "map": {
                    "name": "name"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Level.Talents",
      "type": "list",
      "attribute": "talent",
      "form": {
        "title": "Common.Talent",
        "partial": "talent-uses"
      }
    },
    {
      "title": "Level.Choices",
      "type": "list",
      "attribute": "choice",
      "form": {
        "title": "Common.Talent",
        "partial": "talent-uses"
      }
    }
  ]
}
