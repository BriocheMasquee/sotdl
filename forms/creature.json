            "title": "Creature.Fear",
            "partial": "creature-fear"
          },
          "text": "{% if data.fear.terrifying %}{% if data.fear.feminine %}{{'FearLevel.TerrifyingF'|l}}{% else %}{{'FearLevel.Terrifying'|l}}{% endif %}{% elif data.fear.frightening %}{% if data.fear.feminine %}{{'FearLevel.FrighteningF'|l}}{% else %}{{'FearLevel.Frightening'|l}}{% endif %}{% else %}—{% endif %}"
        },
        {
          "title": "Characteristics.Size",
          "attribute": "data.gabarit",
          "type": "picker",
          "placeholder": "—",
          "attributeType": "BodySize"
        }
      ]
    },
    {
      "type": "group",
