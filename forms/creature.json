    {
      "type": "group",
      "fields": [
        {
          "title": "Creature.Magic",
          "type": "form",
          "attribute": "data",
          "form": {
            "title": "Creature.Magic",
            "partial": "creature-magic-block"
          },
          "text": "{% if data.power %}{{'Characteristics.Power'|l}} {{data.power}}{% endif %}{% if data.power and data.creatureMagic %} · {% endif %}{% for m in data.creatureMagic %}{{m.tradition|map: 'SpellTradition'|l}}{% if forloop.last %}{% else %}, {% endif %}{% endfor %}{% if data.power == nil and data.creatureMagic == nil %}—{% endif %}"
        }
      ]
